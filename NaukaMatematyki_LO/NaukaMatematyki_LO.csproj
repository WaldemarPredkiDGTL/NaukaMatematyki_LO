<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Pracownia LO</Product>
    <AssemblyTitle>Pracownia LO — przedmioty ścisłe i języki</AssemblyTitle>
    <Version>1.0.0</Version>
    <ApplicationIcon>PracowniaLO.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="PracowniaLO.ico" LogicalName="NaukaMatematyki_LO.PracowniaLO.ico" />
  </ItemGroup>

</Project>